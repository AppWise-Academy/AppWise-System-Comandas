PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/database

NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# --- Nodemailer (SMTP) ---
# Si dejás estas variables vacías, el servicio genera automáticamente una
# cuenta de prueba en Ethereal (https://ethereal.email) y te devuelve un
# link de "preview" en la respuesta del endpoint. Ideal para la clase: no
# necesitás credenciales reales para probar el envío de correos.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="<CORREO GMAIL"
SMTP_PASSWORD="<CONTRASEÑA GENERADA APP GMAIL"
MAIL_FROM_NAME=Sistema de Comandas
MAIL_FROM_EMAIL=no-reply@comandas.dev

# --- Resend (https://resend.com) ---
# Con el API Key gratuito de Resend, y sin verificar tu propio dominio,
# SOLO podés enviar correos a la casilla con la que te registraste en Resend.
# Cualquier otro "to" devuelve un 403. Es una restricción de su sandbox, no un bug.
RESEND_API_KEY="<API KEY RESEND"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- Mercado Pago (https://www.mercadopago.com.ar/developers/panel/app) ---
# Access Token de PRUEBA (modo sandbox) de tu aplicación en el panel de
# desarrolladores de Mercado Pago. Sin este valor, la API levanta igual,
# pero /api/payments/create-preference y /webhook van a devolver un error
# claro (MP_NOT_CONFIGURED) en vez de tirar un stack trace crudo del SDK.
MP_ACCESS_TOKEN="<ACCESS TOKEN DE PRUEBA DE TU CUENTA MP>"

# --- URLs públicas (back_urls + notification_url) ---
# BACKEND_URL: a dónde le pega MERCADO PAGO para avisarnos de un pago
# (notification_url = ${BACKEND_URL}/api/payments/webhook).
# En LOCAL, "localhost" NO SIRVE acá: los servidores de Mercado Pago están
# en internet y no tienen forma de llegar a tu PC. Necesitás exponer tu
# backend con un túnel (ej: ngrok) y pegar acá la URL https que te dé,
# por ejemplo: BACKEND_URL=https://a1b2c3d4.ngrok-free.app
# (esto se explica y se hace en vivo en la clase — ver
# DOCUMENTACION_MERCADO_PAGO.md, sección "Túnel para el webhook en local").
BACKEND_URL=http://localhost:4000

# FRONTEND_URL: a dónde redirige MERCADO PAGO el NAVEGADOR del cliente
# después de pagar (back_urls: success/failure/pending). Esta sí puede
# quedar en localhost, porque a quien redirige es al navegador del
# usuario, no a un servidor.
FRONTEND_URL=http://localhost:5173