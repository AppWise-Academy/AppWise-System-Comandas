        {
          "name": "Petición exitosa (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// =======================",
                  "// Status",
                  "// =======================",
                  "pm.test(\"Status 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// =======================",
                  "// Helmet",
                  "// =======================",
                  "pm.test(\"Tiene X-Frame-Options\", () => {",
                  "    pm.response.to.have.header(\"X-Frame-Options\");",
                  "});",
                  "",
                  "pm.test(\"Tiene X-Content-Type-Options\", () => {",
                  "    pm.response.to.have.header(\"X-Content-Type-Options\");",
                  "});",
                  "",
                  "pm.test(\"Tiene Referrer-Policy\", () => {",
                  "    pm.response.to.have.header(\"Referrer-Policy\");",
                  "});",
                  "",
                  "pm.test(\"Tiene Cross-Origin-Opener-Policy\", () => {",
                  "    pm.response.to.have.header(\"Cross-Origin-Opener-Policy\");",
                  "});",
                  "",
                  "pm.test(\"Tiene Cross-Origin-Resource-Policy\", () => {",
                  "    pm.response.to.have.header(\"Cross-Origin-Resource-Policy\");",
                  "});",
                  "",
                  "pm.test(\"Tiene Origin-Agent-Cluster\", () => {",
                  "    pm.response.to.have.header(\"Origin-Agent-Cluster\");",
                  "});",
                  "",
                  "// =======================",
                  "// CORS",
                  "// =======================",
                  "pm.test(\"Tiene Access-Control-Allow-Origin\", () => {",
                  "    pm.response.to.have.header(\"Access-Control-Allow-Origin\");",
                  "});",
                  "",
                  "pm.test(\"Tiene Access-Control-Allow-Credentials\", () => {",
                  "    pm.response.to.have.header(\"Access-Control-Allow-Credentials\");",
                  "});",
                  "",
                  "// =======================",
                  "// Rate Limit",
                  "// =======================",
                  "pm.test(\"Tiene header RateLimit\", () => {",
                  "    pm.response.to.have.header(\"RateLimit-Limit\");",
                  "});",
                  "",
                  "pm.test(\"Tiene header RateLimit-Policy\", () => {",
                  "    pm.response.to.have.header(\"RateLimit-Policy\");",
                  "});",
                  "",
                  "// =======================",
                  "// Estructura respuesta",
                  "// =======================",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Tiene success\", () => {",
                  "    pm.expect(body).to.have.property(\"success\");",
                  "});",
                  "",
                  "pm.test(\"Tiene message\", () => {",
                  "    pm.expect(body).to.have.property(\"message\");",
                  "});",
                  "",
                  "pm.test(\"Tiene timestamp\", () => {",
                  "    pm.expect(body).to.have.property(\"timestamp\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
